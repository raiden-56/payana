{
  "name": "@payana/api",
  "version": "0.1.0",
  "description": "Payana API - modular monolith",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:run": "nest build && node dist/database/migrate.js up",
    "migration:revert": "nest build && node dist/database/migrate.js down",
    "migration:status": "nest build && node dist/database/migrate.js status",
    "seed": "nest build && node dist/database/seed.js",
    "openapi:export": "nest build && node dist/openapi/export.js",
    "totp": "node scripts/totp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/event-emitter": "12.0.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.3",
    "@payana/contracts": "file:../../packages/contracts",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
