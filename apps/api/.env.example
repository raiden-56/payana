# Payana API - environment template.
# Copy to `.env` for local development. Never commit a real `.env`.
# In production every value comes from the secret manager / task definition.

NODE_ENV=development
PORT=3000
APP_NAME=Payana
LOG_LEVEL=info

# Leave empty to return relative URLs for uploads / files (works behind the web
# dev proxy and behind a single production domain). Set to the API origin, e.g.
# https://api.example.com, when clients need absolute URLs (native apps).
PUBLIC_API_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# Local infrastructure from the root docker-compose.yml.
# Host port 5439 is the compose default. If it is already taken on your
# machine start compose with another port, e.g. `PG_HOST_PORT=5440 docker compose up -d --wait postgres redis`,
# and change the port here to match.
DATABASE_URL=postgres://payana:payana_dev_only@localhost:5439/payana
DATABASE_SSL=false
REDIS_URL=redis://localhost:6380

# --- secrets (development-only placeholder values; generate real ones) -------
# openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
SIGNING_SECRET=dev-only-signing-secret-change-me-0123456789abcdef
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true in production (HTTPS). false lets the refresh cookie work on http://localhost.
COOKIE_SECURE=false

# --- adapters ------------------------------------------------------------------
# dev      = log the OTP and echo it in the response as `devCode` (refused in production)
# provider = real SMS gateway adapter (not implemented yet - see README)
SMS_DRIVER=dev
# manual   = no money moves; checkout completes immediately (pilot / development)
# razorpay = gateway adapter (not implemented yet - see README)
PAYMENT_PROVIDER=manual
# local = files under STORAGE_LOCAL_DIR ; s3 = any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- rate limiting (per client IP, all routes) ------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=240

SWAGGER_ENABLED=true
JOBS_ENABLED=true

# --- demo seed (npm run seed; development only) -------------------------------------
# Password for the seeded *@payana.local staff accounts.
SEED_ADMIN_PASSWORD=Payana-Dev-Admin-2026!
# Base32 TOTP secret pre-enrolled on the seeded staff accounts. Add it to any
# authenticator app, or print the current code with `npm run totp`.
SEED_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Require an authenticator code for every administrator role (super_admin always requires it).
ADMIN_MFA_ENFORCE_ALL=false
# Reverse proxies in front of the API (0 locally, 1 behind a load balancer).
TRUST_PROXY=0
# Price of one featured-listing day beyond the plan allowance, in paise (4900 = Rs 49).
FEATURED_PRICE_PER_DAY_MINOR=4900
# Development only: re-stamp the seeded demo drivers so some always look live / recent.
DEMO_POSITION_HEARTBEAT=false
# One-time-code request limits (defaults shown).
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=6
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=30
